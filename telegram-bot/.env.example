# Токен Telegram-бота от @BotFather
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Часовой пояс по умолчанию (используется только как резервный,
# у каждого пользователя сохраняется свой часовой пояс в его БД)
TIMEZONE=Europe/Moscow

# Интервал проверки уведомлений (в секундах)
NOTIFIER_POLL_INTERVAL=60

# Автопулл обновлений с GitHub (1 — включён, 0 — выключен)
AUTO_PULL_ENABLED=1
# Как часто проверять новые коммиты в GitHub (в секундах), минимум 300
AUTO_PULL_INTERVAL=900

# Telegram ID владельцев бота (через запятую) для ручной команды /update
OWNER_IDS=7899153362
